<?xml version="1.0" encoding="utf-8"?>
<!--
    Subtitle overlay. Two modes, switched in SubtitleOverlayService:
    - COMPACT: header row (drag handle + "Xem lại") and the live line only.
    - EXPANDED: header row ("Thu nhỏ" + "Xoá"), scrolling history, then the live line.
    Only the header row is draggable (compact mode); buttons and the ScrollView get their own touches.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/subtitle_background">

        <LinearLayout
            android:id="@+id/overlay_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/overlay_btn_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:text="@string/overlay_expand" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/overlay_btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:visibility="gone"
                android:text="@string/overlay_clear" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/overlay_history_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:fillViewport="false">

            <TextView
                android:id="@+id/overlay_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#E0E0E0"
                android:textSize="32sp"
                android:lineSpacingExtra="6dp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />
        </ScrollView>

        <TextView
            android:id="@+id/overlay_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:maxLines="4"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:gravity="center_vertical"
            android:textAlignment="gravity"
            android:textDirection="inherit" />
    </LinearLayout>

</FrameLayout>
